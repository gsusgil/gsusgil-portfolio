---
/* Theme toggle pill (handoff §2: follows the system, button overrides for the
   session only — the choice is never persisted). Logic lives in portfolio.js. */
interface Props {
  compact?: boolean; // true = mobile tabbar icon-only variant
}
const { compact = false } = Astro.props;
---

{compact ? (
  <button class="theme" data-theme-btn aria-label="Switch theme"><i></i></button>
) : (
  <button class="pill theme" data-theme-btn><i></i><span>Light</span></button>
)}
