---
// Case study page, ported from the openCase() section of handoff/gsusgil-portfolio.html.
// Real per-project route (handoff §6.5) instead of the prototype's overlay-over-home.
// The open/close/switch transitions are View Transitions (see components.css .vt-open/
// .vt-close/.vt-switch and src/scripts/view-transitions.js), not the prototype's overlay.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactPill from "../../components/ContactPill.astro";
import { projects, getProjectBySlug } from "../../data/projects/index.js";

export async function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
// Project data files are plain, differently-shaped JS objects (flat vs. chapters, long vs.
// not) — cast once here rather than modelling every shape as a TS union.
const project: any = getProjectBySlug(slug);
if (!project) throw new Error("Project not found");

const i = projects.findIndex((p) => p.slug === slug);
const prev: any = projects[(i + projects.length - 1) % projects.length];
const next: any = projects[(i + 1) % projects.length];

const isChapters = Boolean(project.chapters);
const isLong = Boolean(project.long);
---

<BaseLayout title={`${project.name} — gsusgil`} description={project.idea}>
  <main class="in-wrap">
    <div class="stag">
      <div class="hero">
        <img src={project.hero.src} alt={project.hero.alt} />
      </div>
      <div class="thirds ctext">
        <p class="idea">{project.idea}</p>
        <div class="desc">
          <p>{project.d1}</p>
          <p>{project.d2}</p>
        </div>
        <div class="info">
          {project.stats.length > 0 && (
            <div class="stats">
              {project.stats.map(([v, l]: [string, string]) => (
                <div>
                  <strong>{v}</strong>
                  <span class="mute">{l}</span>
                </div>
              ))}
            </div>
          )}
          <div class="meta">
            <span class="mute">Client</span><span>{project.client}</span>
            <span class="mute">Year</span><span>{project.year || "To be added"}</span>
            <span class="mute">Role</span><span>{project.role}</span>
            {project.key && (
              <>
                <span class="mute">Decision</span><span>{project.key}</span>
              </>
            )}
            <span class="mute">Result</span><span>{project.out}</span>
            {project.bench && (
              <>
                <span class="mute">Benchmark</span><span class="mute">Account average to be added</span>
                <span class="mute">Note</span><span class="mute">Figures rounded for client confidentiality.</span>
              </>
            )}
          </div>
        </div>
      </div>
    </div>

    {!isChapters && (
      <div class="shots">
        {project.shots.map((shot, n) => {
          const cls = `${isLong ? "b" : "s"}${n}`;
          const sfLong = isLong && n < 2;
          return (
            <figure class={`shot ${cls}${shot.video ? " vid" : ""}`}>
              <div class={`sf${sfLong ? " long" : ""}`}>
                {shot.video ? (
                  <video src={shot.video} poster={shot.poster} autoplay muted loop playsinline preload="metadata" />
                ) : shot.placeholder ? (
                  <div class="pending">Pending</div>
                ) : (
                  <img src={shot.src} alt={shot.caption} loading="lazy" />
                )}
              </div>
              <figcaption>
                <span>{shot.caption}</span>
                {sfLong && <span class="mute">Full length · scrolls with the page</span>}
              </figcaption>
            </figure>
          );
        })}
      </div>
    )}

    {isChapters &&
      project.chapters.map((ch, c) => (
        <>
          <div class="thirds chap">
            <h3>{ch.name}</h3>
            <span class="mute">
              Client 0{c + 1} of 0{project.chapters.length}
            </span>
          </div>
          <div class="thirds sub">
            <div class="cdesc">
              <p>{ch.d1}</p>
              <p>{ch.d2}</p>
            </div>
            <div class="info">
              <div class="meta">
                <span class="mute">Client</span><span>{ch.client}</span>
                <span class="mute">Year</span><span>{ch.year || "To be added"}</span>
                <span class="mute">Role</span><span>{ch.role}</span>
                <span class="mute">Decision</span><span>{ch.key}</span>
                <span class="mute">Result</span><span>{ch.out}</span>
              </div>
            </div>
          </div>
          <div class="shots">
            {ch.shots.map((shot, n) => (
              <figure class={`shot ${c % 2 ? "m" : "k"}${n}${n === 0 ? " vid" : ""}`}>
                <div class="sf">
                  {shot.video ? (
                    <video src={shot.video} poster={shot.poster} autoplay muted loop playsinline preload="metadata" />
                  ) : shot.placeholder ? (
                    <div class="pending">Pending</div>
                  ) : (
                    <img src={shot.src} alt={shot.caption} loading="lazy" />
                  )}
                </div>
                <figcaption><span>{shot.caption}</span></figcaption>
              </figure>
            ))}
          </div>
        </>
      ))}

    <div class="thirds credits">
      <span class="mute">Credits</span>
      <div class="meta">
        <span>Jesús Gil</span><span class="mute">({project.role.split(",")[0]})</span>
        {project.creditsNote ? (
          <>
            <span>{project.creditsNote}</span><span class="mute">(Stakeholders)</span>
          </>
        ) : (
          <>
            <span>Collaborators</span><span class="mute">(To be added)</span>
          </>
        )}
      </div>
    </div>

    <div class="thirds endcta">
      <span class="mute">Want the story behind this project?</span>
      <div>
        <span class="mail">gsusgildesigner@gmail.com</span>
        <ContactPill />
      </div>
    </div>

    <div class="pn">
      <a href={`/projects/${prev.slug}`}><span class="mute">Previous</span><strong>{prev.name}</strong></a>
      <a href={`/projects/${next.slug}`}><span class="mute">Next</span><strong>{next.name}</strong></a>
    </div>
  </main>

  <div class="dock">
    <span>{project.name}</span>
    <a href="/" data-close aria-label="Close project">×</a>
  </div>

  <script>
    import "../../scripts/project.js";
  </script>
</BaseLayout>
